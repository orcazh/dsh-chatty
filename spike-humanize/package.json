{
  "name": "spike-humanize",
  "version": "0.0.0",
  "type": "module",
  "description": "Throwaway Phase 0 probe plugin for DSH Desktop",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
