{
  "name": "dsh-chatty",
  "version": "0.1.0",
  "type": "module",
  "description": "把 AI 的一条回复拆成几条消息、隔一会儿发一条，像人在聊天。可调节奏与气泡配色，可只在选定会话生效。",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "chat",
    "bubbles",
    "humanize",
    "typing"
  ],
  "license": "MIT",
  "author": "orcazh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orcazh/dsh-chatty.git"
  },
  "homepage": "https://github.com/orcazh/dsh-chatty#readme",
  "bugs": {
    "url": "https://github.com/orcazh/dsh-chatty/issues"
  },
  "main": "lib/host.js",
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2",
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
