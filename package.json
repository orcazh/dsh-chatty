{
  "name": "dsh-chatty-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Development workspace for the dsh-chatty plugin (the plugin itself lives in dsh-chatty/)",
  "scripts": {
    "check": "node --check dsh-chatty/lib/host.js && node --check dsh-chatty/lib/client.js",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify-mount.mjs",
    "scope": "node scripts/scope.mjs",
    "g2": "node scripts/g2-score.mjs",
    "install:plugin": "node scripts/install.mjs",
    "uninstall:plugin": "node scripts/uninstall.mjs",
    "pack:check": "npm pack --dry-run ./dsh-chatty"
  }
}
